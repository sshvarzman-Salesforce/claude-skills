<?xml version="1.0" encoding="UTF-8"?>
<!--
  Inbound VOICE routing flow: hands a live VoiceCall to an Agentforce Service Agent (ASA).
  Verified live (CitiBank_ASA_Inbound_Voice, Active). Swap the tokens marked  <<...>>  for your org:
    <<COPILOT_BOT_DEVNAME>>  the ASA agent's BotDefinition DeveloperName   (setupReference)
    <<COPILOT_LABEL>>        the ASA agent's display label
    <<FALLBACK_QUEUE_ID>>    a REAL Group.Id (00G...) queue — REQUIRED even when routing to a copilot
    <<FALLBACK_QUEUE_LABEL>> that queue's label
    <<CUSTOMER_DEMO_VALUE>>  (optional) demo-tag stamped on the VoiceCall; delete the inputAssignment if unused
  Contact resolution: findMatchingIndividuals on phone -> link Contact to VoiceCall.Contact__c (custom lookup).
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Load_Contact_by_Phone_Number</name>
        <label>Load Contact by Phone Number</label>
        <locationX>182</locationX>
        <locationY>650</locationY>
        <actionName>findMatchingIndividuals</actionName>
        <actionType>findMatchingIndividuals</actionType>
        <connector>
            <targetReference>Loop_Search_Results</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>searchTerm</name>
            <value>
                <elementReference>phoneToSearch</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>searchFields</name>
            <value>
                <stringValue>Phone</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>searchObject</name>
            <value>
                <stringValue>Contact</stringValue>
            </value>
        </inputParameters>
        <nameSegment>findMatchingIndividuals</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Route_to_ASA</name>
        <label>Route to ASA</label>
        <locationX>182</locationX>
        <locationY>1358</locationY>
        <actionName>routeWork</actionName>
        <actionType>routeWork</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelLabel</name>
            <value>
                <stringValue>Phone</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelDevName</name>
            <value>
                <stringValue>sfdc_phone</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>routingType</name>
            <value>
                <stringValue>Copilot</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>queueLabel</name>
            <value>
                <stringValue>&lt;&lt;FALLBACK_QUEUE_LABEL&gt;&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>copilotLabel</name>
            <value>
                <stringValue>&lt;&lt;COPILOT_LABEL&gt;&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelId</name>
            <value>
                <setupReference>sfdc_phone</setupReference>
                <setupReferenceType>ServiceChannel</setupReferenceType>
            </value>
        </inputParameters>
        <inputParameters>
            <name>copilotId</name>
            <value>
                <setupReference>&lt;&lt;COPILOT_BOT_DEVNAME&gt;&gt;</setupReference>
                <setupReferenceType>BotDefinition</setupReferenceType>
            </value>
        </inputParameters>
        <inputParameters>
            <name>queueId</name>
            <value>
                <stringValue>&lt;&lt;FALLBACK_QUEUE_ID&gt;&gt;</stringValue>
            </value>
        </inputParameters>
        <nameSegment>routeWork</nameSegment>
        <offset>0</offset>
        <versionString>2.0.0</versionString>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Resolve_Phone_To_Search</name>
        <label>Resolve Phone To Search</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>phoneToSearch</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>phone</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Read_Voice_Call</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Use_FromPhoneNumber</name>
        <label>Use FromPhoneNumber</label>
        <locationX>270</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>phoneToSearch</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Read_Voice_Call.FromPhoneNumber</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Load_Contact_by_Phone_Number</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Found_Contact</name>
        <label>Check Found Contact</label>
        <locationX>182</locationX>
        <locationY>1058</locationY>
        <defaultConnector>
            <targetReference>Stamp_Voice_Call</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact</defaultConnectorLabel>
        <rules>
            <name>Found_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Contact_And_Stamp</targetReference>
            </connector>
            <label>Found Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Phone_Input_Provided</name>
        <label>Phone Input Provided?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Use_FromPhoneNumber</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Use VoiceCall FromPhoneNumber</defaultConnectorLabel>
        <rules>
            <name>Phone_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>phone</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Load_Contact_by_Phone_Number</targetReference>
            </connector>
            <label>Phone Provided</label>
        </rules>
    </decisions>
    <description>Inbound voice routing flow: finds the Contact by phone (fallback to VoiceCall.FromPhoneNumber), links it to VoiceCall.Contact__c, and hands the call to the ASA agent (routingType=Copilot) with a required fallback queue.</description>
    <environments>Default</environments>
    <interviewLabel>Inbound ASA Voice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Inbound ASA Voice</label>
    <loops>
        <name>Loop_Search_Results</name>
        <label>Loop Search Results</label>
        <locationX>182</locationX>
        <locationY>758</locationY>
        <collectionReference>Load_Contact_by_Phone_Number.contactIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Load_Found_Contact</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Found_Contact</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>RoutingFlow</processType>
    <recordLookups>
        <name>Load_Found_Contact</name>
        <label>Load Found Contact</label>
        <locationX>270</locationX>
        <locationY>866</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Search_Results</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Search_Results</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Read_Voice_Call</name>
        <label>Read Voice Call</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Phone_Input_Provided</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>VoiceCall</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FromPhoneNumber</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Link_Contact_And_Stamp</name>
        <label>Link Contact And Stamp</label>
        <locationX>50</locationX>
        <locationY>1166</locationY>
        <connector>
            <targetReference>Route_to_ASA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>contact.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Customer_Demo__c</field>
            <value>
                <stringValue>&lt;&lt;CUSTOMER_DEMO_VALUE&gt;&gt;</stringValue>
            </value>
        </inputAssignments>
        <object>VoiceCall</object>
    </recordUpdates>
    <recordUpdates>
        <name>Stamp_Voice_Call</name>
        <label>Stamp Voice Call</label>
        <locationX>314</locationX>
        <locationY>1166</locationY>
        <connector>
            <targetReference>Route_to_ASA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Customer_Demo__c</field>
            <value>
                <stringValue>&lt;&lt;CUSTOMER_DEMO_VALUE&gt;&gt;</stringValue>
            </value>
        </inputAssignments>
        <object>VoiceCall</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Resolve_Phone_To_Search</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>contact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>phone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>phoneToSearch</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
