        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Add Full Context</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>=== INH ESCALATION CASE (the case this summary is for) ===
Case Number: {!Get_INH_Case.CaseNumber}
Subject: {!Get_INH_Case.Subject}
Description: {!Get_INH_Case.Description}
Status: {!Get_INH_Case.Status}
Priority: {!Get_INH_Case.Priority}
Type: {!Get_INH_Case.Type}
Sub Type: {!Get_INH_Case.SDO_Sub_Type__c}

=== ORIGINATING (PARENT) CASE ===
Parent Case Number: {!Get_INH_Case.Parent.CaseNumber}
Parent Subject: {!Get_INH_Case.Parent.Subject}
Parent Description: {!Get_INH_Case.Parent.Description}
Parent Status: {!Get_INH_Case.Parent.Status}
Parent Priority: {!Get_INH_Case.Parent.Priority}
Parent Origin: {!Get_INH_Case.Parent.Origin}
Parent Reason: {!Get_INH_Case.Parent.Reason}
Parent Type: {!Get_INH_Case.Parent.Type}
Escalated: {!Get_INH_Case.Parent.IsEscalated}

=== CONTACT (the customer) ===
Name: {!Get_INH_Case.Contact.Name}
Title: {!Get_INH_Case.Contact.Title}
Email: {!Get_INH_Case.Contact.Email}
Phone: {!Get_INH_Case.Contact.Phone}
Mobile: {!Get_INH_Case.Contact.MobilePhone}
Preferred Channel: {!Get_INH_Case.Contact.SDO_PA_Preferred_Contact_Channel__c}
Pronouns: {!Get_INH_Case.Contact.SDO_PA_Inclusive_Pronouns__c}
Contact Notes: {!Get_INH_Case.Contact.Description}

=== ACCOUNT ===
Account: {!Get_INH_Case.Account.Name}
Type: {!Get_INH_Case.Account.Type}
Industry: {!Get_INH_Case.Account.Industry}
Rating: {!Get_INH_Case.Account.Rating}
Account Notes: {!Get_INH_Case.Account.Description}
</stringValue>
            </value>
        </assignmentItems>
        <connector><targetReference>Which_Channel</targetReference></connector>
    </assignments>
