<?xml version="1.0" encoding="UTF-8"?>
<!--
  GenAiFunction meta for a CLT-rendering action.

  Replace before deploying:
    - The directory name and this filename to match __FUNCTION_NAME__
    - input/schema.json and output/schema.json placeholders
    - <invocationTarget> below to flow://__FUNCTION_NAME__
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Renders the __TYPE_NAME__ CLT inline. The output is always renderable — use show_command.</description>
    <invocationTarget>flow://__FUNCTION_NAME__</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <masterLabel>__FUNCTION_NAME__</masterLabel>
</GenAiFunction>
