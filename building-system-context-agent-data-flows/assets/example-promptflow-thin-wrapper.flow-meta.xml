<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Intro_And_Claims</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Add Intro And Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>OPEN INSURANCE CLAIM LOOKUP for the customer {!Get_Contact.Name}.
The records below (if any) are ALL of this customer&apos;s currently OPEN / ACTIVE insurance claims (statuses: Open, Under Review, Pending, Requested Information, Submitted, Approved). Claims that were Denied, Closed, or Paid-in-Full are intentionally NOT included here.
Each claim carries a Structured Detail block inside its Summary; parse the Provider, Service Date, Referral Required, Referral On File, and Details values out of those lines when answering.
</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Read_Open_Claims.claimsText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_None</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_None_Found_To_Prompt</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Add None Found To Prompt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>NO OPEN CLAIMS FOUND for {!Get_Contact.Name}. This customer has no open or active insurance claims on file right now. Address the customer by their first name, let them know there are no open claims on their account, and offer to help them open a new claim. Do NOT invent or list any claims.
</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_None</name>
        <label>Check None</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Has Claims</defaultConnectorLabel>
        <rules>
            <name>None_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Read_Open_Claims.openClaimCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_None_Found_To_Prompt</targetReference>
            </connector>
            <label>None Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>ClaimSecure Get Open Claims {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ClaimSecure Get Open Claims</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>PromptFlow</processType>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Read_Open_Claims</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact</targetReference>
        </connector>
        <triggerType>Capability</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Read_Open_Claims</name>
        <label>Read Open Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_Intro_And_Claims</targetReference>
        </connector>
        <flowName>ClaimSecure_Read_Open_Claims</flowName>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <inputAssignments>
            <name>contactId</name>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
