<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Claim_To_Text</name>
        <label>Add Claim To Text</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>claimCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>claimsText</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>
------------------------------
CLAIM
Claim Number: {!Loop_Claims.Claim.Name}
Claim Type: {!Loop_Claims.Claim.ClaimType}
Status: {!Loop_Claims.Claim.Status}
Estimated Amount: {!Loop_Claims.Claim.EstimatedAmount}
Reason: {!Loop_Claims.Claim.ClaimReason}
Structured Detail (parse Provider / Service Date / Referral Required / Referral On File / Details from these lines):
{!Loop_Claims.Claim.Summary}
</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Claims</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Count</name>
        <label>Set Count Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>openClaimCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>claimCount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Open_Status</name>
        <label>Is Open Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Open</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Loop_Claims</targetReference>
        </defaultConnector>
        <rules>
            <name>Status_Is_Open</name>
            <conditionLogic>1 OR 2 OR 3 OR 4 OR 5 OR 6</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Information</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Claims.Claim.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Claim_To_Text</targetReference>
            </connector>
            <label>Status Is Open</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>ClaimSecure Read Open Claims {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ClaimSecure Read Open Claims</label>
    <loops>
        <name>Loop_Claims</name>
        <label>Loop Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Claims</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Open_Status</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Claims</name>
        <label>Get Open Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Claims</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParticipantContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ClaimParticipant</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Claims</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>claimCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>claimsText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>openClaimCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
